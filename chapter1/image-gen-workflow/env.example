# 改写节点 LLM（Mimo，OpenAI 兼容接口）
MIMO_API_KEY=your-mimo-api-key
MIMO_BASE_URL=https://token-plan-cn.xiaomimimo.com/v1
REWRITE_MODEL=mimo-v2.5-pro

# 原生路线 A（Qwen Image 3.0，DashScope 同步接口）
QWEN_IMAGE_API_KEY=your-qwen-image-api-key
QWEN_IMAGE_BASE_URL=https://your-workspace.cn-beijing.maas.aliyuncs.com/api/v1
QWEN_IMAGE_MODEL=qwen-image-3.0
QWEN_IMAGE_SIZE=1024*1024
# QWEN_PROMPT_EXTEND=true

# 工作流路线生图工具（阿里云百炼 DashScope，通义万相文生图）
DASHSCOPE_API_KEY=your-dashscope-api-key
DASHSCOPE_BASE_URL=https://your-workspace.cn-beijing.maas.aliyuncs.com/api/v1

# 工作流路线生图工具（首选方案，实验时账户余额为 0 不可用，保留作记录）
SILICONFLOW_API_KEY=your-siliconflow-api-key

# 可选：GPT-Image 2 原生路线补充对照（仅宽泛需求主用例，--with-gpt-image 时需要）
# OPENAI_API_KEY=your-openai-api-key

# 可选配置（均有默认值）
# WANX_MODEL=wan2.2-t2i-flash
# WANX_SIZE=1024*1024
# GPT_IMAGE_MODEL=gpt-image-2
# SILICONFLOW_IMAGE_MODEL=black-forest-labs/FLUX.1-schnell
